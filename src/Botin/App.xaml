<Application x:Class="Botin.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Botin.UI"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <!-- ===== Paleta: los valores viven en UI/Palette.cs ===== -->
        <x:Static x:Key="BgColor" Member="ui:Palette.BgColor"/>
        <x:Static x:Key="Bg" Member="ui:Palette.Bg"/>
        <x:Static x:Key="Surface" Member="ui:Palette.Surface"/>
        <x:Static x:Key="Surface2" Member="ui:Palette.Surface2"/>
        <x:Static x:Key="SurfaceHover" Member="ui:Palette.SurfaceHover"/>
        <x:Static x:Key="Line" Member="ui:Palette.Line"/>
        <x:Static x:Key="Text" Member="ui:Palette.Text"/>
        <x:Static x:Key="Muted" Member="ui:Palette.Muted"/>
        <x:Static x:Key="Dim" Member="ui:Palette.Dim"/>
        <x:Static x:Key="Gold" Member="ui:Palette.Gold"/>
        <x:Static x:Key="GoldLight" Member="ui:Palette.GoldLight"/>
        <x:Static x:Key="GoldLabel" Member="ui:Palette.GoldLabel"/>
        <x:Static x:Key="GoldData" Member="ui:Palette.GoldData"/>
        <x:Static x:Key="GoldInk" Member="ui:Palette.GoldInk"/>
        <x:Static x:Key="GoldTint" Member="ui:Palette.GoldTint"/>
        <x:Static x:Key="GoldSoft" Member="ui:Palette.GoldSoft"/>
        <x:Static x:Key="Purple" Member="ui:Palette.Purple"/>
        <x:Static x:Key="PurpleData" Member="ui:Palette.PurpleData"/>
        <x:Static x:Key="PurpleSoft" Member="ui:Palette.PurpleSoft"/>
        <x:Static x:Key="Teal" Member="ui:Palette.Teal"/>
        <x:Static x:Key="TealData" Member="ui:Palette.TealData"/>
        <x:Static x:Key="Green" Member="ui:Palette.Green"/>
        <x:Static x:Key="Red" Member="ui:Palette.Red"/>
        <x:Static x:Key="UpBg" Member="ui:Palette.UpBg"/>
        <x:Static x:Key="DownBg" Member="ui:Palette.DownBg"/>
        <x:Static x:Key="GoldText" Member="ui:Palette.GoldText"/>
        <x:Static x:Key="HeroBg" Member="ui:Palette.HeroBg"/>

        <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
        <FontFamily x:Key="NumFont">Bahnschrift</FontFamily>

        <!-- ===== Ícono y marca de Botín (los mismos dibujos que Assets/Botin.ico) ===== -->
        <!-- Marca de Botín: cofre dorado abierto, la tapa volcada hacia atrás y la luz del botín saliendo. Lienzo de 256. -->
        <DrawingGroup x:Key="Mark">
            <GeometryDrawing Brush="#00000000" Geometry="M0,0 H256 V256 H0 Z"/>
            <!-- Resplandor -->
            <GeometryDrawing Geometry="M24,112 A104,94 0 1 0 232,112 A104,94 0 1 0 24,112 Z">
                <GeometryDrawing.Brush>
                    <RadialGradientBrush>
                        <GradientStop Color="#B3FFE7A8" Offset="0"/>
                        <GradientStop Color="#40FCBB39" Offset="0.5"/>
                        <GradientStop Color="#00FCBB39" Offset="1"/>
                    </RadialGradientBrush>
                </GeometryDrawing.Brush>
            </GeometryDrawing>
            <!-- Tapa abierta: cara de adentro (oscura) -->
            <GeometryDrawing Geometry="M70,122 L60,78 C58,64 70,56 84,56 H172 C186,56 198,64 196,78 L186,122 Z">
                <GeometryDrawing.Brush>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#8A5410" Offset="0"/>
                        <GradientStop Color="#4A2B06" Offset="1"/>
                    </LinearGradientBrush>
                </GeometryDrawing.Brush>
            </GeometryDrawing>
            <!-- Borde dorado de la tapa -->
            <GeometryDrawing Geometry="M60,78 C58,64 70,56 84,56 H172 C186,56 198,64 196,78 L193,92 C194,80 186,72 172,72 H84 C70,72 62,80 63,92 Z">
                <GeometryDrawing.Brush>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#FFE7A8" Offset="0"/>
                        <GradientStop Color="#EE9E10" Offset="1"/>
                    </LinearGradientBrush>
                </GeometryDrawing.Brush>
            </GeometryDrawing>
            <!-- Boca del cofre, encendida -->
            <GeometryDrawing Geometry="M56,142 L70,120 H186 L200,142 Z">
                <GeometryDrawing.Brush>
                    <RadialGradientBrush Center="0.5,0.9" GradientOrigin="0.5,0.9" RadiusX="0.6" RadiusY="1.2">
                        <GradientStop Color="#FFFFFFFF" Offset="0"/>
                        <GradientStop Color="#FFFFF0C2" Offset="0.45"/>
                        <GradientStop Color="#FFFFC94D" Offset="1"/>
                    </RadialGradientBrush>
                </GeometryDrawing.Brush>
            </GeometryDrawing>
            <!-- Cuerpo -->
            <GeometryDrawing Geometry="M58,140 H198 V198 C198,207 192,212 183,212 H73 C64,212 58,207 58,198 Z">
                <GeometryDrawing.Brush>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#FCBB39" Offset="0"/>
                        <GradientStop Color="#C48800" Offset="1"/>
                    </LinearGradientBrush>
                </GeometryDrawing.Brush>
            </GeometryDrawing>
            <!-- Correas -->
            <GeometryDrawing Brush="#B07206" Geometry="M80,140 H93 V212 H80 Z M163,140 H176 V212 H163 Z"/>
            <!-- Filo de luz arriba del cuerpo -->
            <GeometryDrawing Brush="#FFE7A8" Geometry="M58,140 H198 V147 H58 Z"/>
            <!-- Cerradura -->
            <GeometryDrawing Brush="#2A1C07" Geometry="M114,160 H142 C145,160 147,162 147,165 V186 C147,189 145,191 142,191 H114 C111,191 109,189 109,186 V165 C109,162 111,160 114,160 Z"/>
            <GeometryDrawing Brush="#FFDA7C" Geometry="M122.5,171 A5.5,5.5 0 1 1 133.5,171 A5.5,5.5 0 1 1 122.5,171 Z M125.5,173 H130.5 L132,184 H124 Z"/>
        </DrawingGroup>

        <!-- Rayos y destellos: solo en tamaños grandes (en la bandeja serían ruido). -->
        <DrawingGroup x:Key="MarkFx">
            <GeometryDrawing Geometry="M108,128 L80,26 L104,20 L122,128 Z M122,128 L117,8 L139,8 L134,128 Z M134,128 L152,20 L176,26 L148,128 Z">
                <GeometryDrawing.Brush>
                    <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                        <GradientStop Color="#A6FFF4D6" Offset="0"/>
                        <GradientStop Color="#00FFF4D6" Offset="0.85"/>
                    </LinearGradientBrush>
                </GeometryDrawing.Brush>
            </GeometryDrawing>
            <GeometryDrawing Brush="#FFF4D6" Geometry="M210,30 C212,45 216,49 231,51 C216,53 212,57 210,72 C208,57 204,53 189,51 C204,49 208,45 210,30 Z"/>
            <GeometryDrawing Brush="#CCFFF4D6" Geometry="M50,40 C51,47 53,49 60,50 C53,51 51,53 50,60 C49,53 47,51 40,50 C47,49 49,47 50,40 Z"/>
        </DrawingGroup>

        <!-- Baldosa del ícono: azul noche con un filo de luz dorada arriba. -->
        <GeometryDrawing x:Key="Tile" Geometry="M64,8 H192 C223,8 248,33 248,64 V192 C248,223 223,248 192,248 H64 C33,248 8,223 8,192 V64 C8,33 33,8 64,8 Z">
            <GeometryDrawing.Brush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#1F2945" Offset="0"/>
                    <GradientStop Color="#090E18" Offset="1"/>
                </LinearGradientBrush>
            </GeometryDrawing.Brush>
            <GeometryDrawing.Pen>
                <Pen Thickness="4">
                    <Pen.Brush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#99FCBB39" Offset="0"/>
                            <GradientStop Color="#1AFCBB39" Offset="0.5"/>
                            <GradientStop Color="#00FCBB39" Offset="1"/>
                        </LinearGradientBrush>
                    </Pen.Brush>
                </Pen>
            </GeometryDrawing.Pen>
        </GeometryDrawing>

        <!-- La marca sola (overlay, marca de agua) y el ícono completo con su baldosa (menú lateral, estado vacío). -->
        <DrawingImage x:Key="ChestIcon" Drawing="{StaticResource Mark}"/>
        <DrawingImage x:Key="AppIcon">
            <DrawingImage.Drawing>
                <DrawingGroup>
                    <StaticResource ResourceKey="Tile"/>
                    <StaticResource ResourceKey="Mark"/>
                    <StaticResource ResourceKey="MarkFx"/>
                </DrawingGroup>
            </DrawingImage.Drawing>
        </DrawingImage>

        <!-- ===== Texto ===== -->
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
        </Style>
        <Style x:Key="Sub" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="BigNum" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource NumFont}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="34"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
        </Style>

        <!-- ===== Tarjeta ===== -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="20"/>
        </Style>

        <!-- ===== Botones ===== -->
        <Style x:Key="BtnBase" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Background" Value="{StaticResource Surface2}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource SurfaceHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="b" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Btn" TargetType="Button" BasedOn="{StaticResource BtnBase}"/>
        <Style x:Key="BtnGold" TargetType="Button" BasedOn="{StaticResource BtnBase}">
            <Setter Property="Background" Value="{StaticResource Gold}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Gold}"/>
            <Setter Property="Foreground" Value="{StaticResource GoldInk}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource GoldLight}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="b" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="BtnGhost" TargetType="Button" BasedOn="{StaticResource BtnBase}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="Padding" Value="10,6"/>
        </Style>
        <Style x:Key="IconBtn" TargetType="Button" BasedOn="{StaticResource BtnBase}">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Normal"/>
        </Style>

        <!-- ===== Interruptor (CheckBox) ===== -->
        <Style x:Key="Switch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ContentPresenter VerticalAlignment="Center" Margin="0,0,14,0"/>
                            <Border x:Name="track" Grid.Column="1" Width="42" Height="24" CornerRadius="12"
                                    Background="{StaticResource SurfaceHover}" VerticalAlignment="Center">
                                <Ellipse x:Name="knob" Width="18" Height="18" Fill="{StaticResource Muted}" HorizontalAlignment="Left" Margin="3,0">
                                    <Ellipse.RenderTransform>
                                        <TranslateTransform x:Name="tt" X="0"/>
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="track" Property="Background" Value="{StaticResource Gold}"/>
                                <Setter TargetName="knob" Property="Fill" Value="{StaticResource GoldInk}"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="tt" Storyboard.TargetProperty="X" To="18" Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="tt" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Segmentado (RadioButton) ===== -->
        <Style x:Key="Segment" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="b" CornerRadius="8" Padding="12,7" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource GoldSoft}"/>
                                <Setter Property="Foreground" Value="{StaticResource Gold}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Slider ===== -->
        <Style x:Key="SliderThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Ellipse Width="16" Height="16" Fill="{StaticResource Gold}" Stroke="{StaticResource GoldInk}" StrokeThickness="2"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SliderFill" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Height="4" CornerRadius="2" Background="{TemplateBinding Background}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Slider">
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Track x:Name="PART_Track" Height="20">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource SliderFill}" Background="{StaticResource Gold}" Command="Slider.DecreaseLarge"/>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource SliderFill}" Background="{StaticResource SurfaceHover}" Command="Slider.IncreaseLarge"/>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource SliderThumb}"/>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Barra de scroll fina ===== -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border CornerRadius="3" Background="{StaticResource Line}" Margin="3,2"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Menú contextual ===== -->
        <Style TargetType="ContextMenu">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{StaticResource Surface2}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="6">
                            <StackPanel IsItemsHost="True"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="MenuItem">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="b" Padding="12,8" CornerRadius="6" Background="Transparent" MinWidth="200">
                            <ContentPresenter ContentSource="Header"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource SurfaceHover}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Gold}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="{StaticResource Surface2}"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="Padding" Value="10,6"/>
        </Style>
    </Application.Resources>
</Application>

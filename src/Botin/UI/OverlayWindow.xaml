<Window x:Class="Botin.UI.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Botín overlay" AllowsTransparency="True" WindowStyle="None" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize" SizeToContent="WidthAndHeight"
        FontFamily="{StaticResource UiFont}" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <!--
        Overlay de Botín. Una sola pastilla, lo más quieta posible mientras jugás:
        anillo de la meta del día (con el porcentaje al centro y un punto rojo que late durante la partida),
        el total y, al lado, la sesión y los tesoros. Al terminar una partida aparece debajo el "momento":
        los cofres de esa partida suben, el récord brilla y después se actualizan el total y el anillo.
        Los colores salen de la paleta (UI/Palette.cs); los degradés llevan los mismos valores en hex.
    -->
    <Window.Resources>
        <Style x:Key="Cap" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Foreground" Value="{StaticResource Dim}"/>
            <Setter Property="Margin" Value="0,1,0,0"/>
        </Style>
        <Style x:Key="Stat" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource NumFont}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="19"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Margin" Value="0,-2,0,-2"/>
        </Style>
        <Style x:Key="Divider" TargetType="Rectangle">
            <Setter Property="Width" Value="1"/>
            <Setter Property="Margin" Value="14,9,14,9"/>
            <Setter Property="Fill" Value="#1CFFFFFF"/>
        </Style>
    </Window.Resources>

    <Grid x:Name="Root" Margin="10">
        <Grid.LayoutTransform>
            <ScaleTransform x:Name="RootScale" ScaleX="1" ScaleY="1"/>
        </Grid.LayoutTransform>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ============ Pastilla ============ -->
        <Grid x:Name="Pill" HorizontalAlignment="Left">
            <Border x:Name="Card" CornerRadius="18" BorderThickness="1">
                <Border.BorderBrush><SolidColorBrush Color="#1FFFFFFF"/></Border.BorderBrush>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#F5161D2B" Offset="0"/>
                        <GradientStop Color="#F20B1019" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border.Effect>
                    <DropShadowEffect x:Name="CardShadow" BlurRadius="16" ShadowDepth="2" Opacity="0.55" Color="Black"/>
                </Border.Effect>
                <Grid>
                    <!-- Filo de luz arriba, como un vidrio -->
                    <Border x:Name="Sheen" Height="1" VerticalAlignment="Top" Margin="18,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#00FFFFFF" Offset="0"/>
                                <GradientStop Color="#38FFFFFF" Offset="0.5"/>
                                <GradientStop Color="#00FFFFFF" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <StackPanel x:Name="Content" Orientation="Horizontal" Margin="7,7,18,7">
                        <!-- Anillo de la meta -->
                        <Grid x:Name="RingBlock" Width="44" Height="44" Margin="0,0,11,0" VerticalAlignment="Center">
                            <Ellipse x:Name="RingTrack" Stroke="{StaticResource SurfaceHover}" StrokeThickness="4"/>
                            <Path x:Name="RingArc" Stroke="{StaticResource Gold}" StrokeThickness="4"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            <Ellipse x:Name="RingGlow" Stroke="{StaticResource Gold}" StrokeThickness="4" Opacity="0" IsHitTestVisible="False">
                                <Ellipse.Effect><DropShadowEffect BlurRadius="14" ShadowDepth="0" Color="#FCBB39" Opacity="1"/></Ellipse.Effect>
                            </Ellipse>
                            <!-- Centro del anillo: cuánto de la meta llevás (o ✓ cuando la cumpliste) -->
                            <TextBlock x:Name="RingPct" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="1,0,0,1"
                                       FontFamily="{StaticResource NumFont}" FontWeight="Bold" FontSize="14" Foreground="{StaticResource Text}">
                                <Run x:Name="RingPctValue" Text="0"/><Run x:Name="RingPctUnit" Text="%" FontSize="9" Foreground="{StaticResource Dim}"/>
                            </TextBlock>
                            <!-- Durante la partida: una insignia roja que late en la esquina del anillo; el cofre queda -->
                            <Grid x:Name="LiveDot" Width="11" Height="11" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,1,1,0" Visibility="Collapsed">
                                <Ellipse x:Name="LiveHalo" Fill="{StaticResource Red}" RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.RenderTransform><ScaleTransform x:Name="LiveHaloScale"/></Ellipse.RenderTransform>
                                </Ellipse>
                                <Ellipse Fill="{StaticResource Red}" Stroke="#F20B1019" StrokeThickness="2"/>
                            </Grid>
                        </Grid>

                        <!-- Total y avance del día -->
                        <StackPanel VerticalAlignment="Center" Margin="0,0,2,0">
                            <!-- Punto rojo de respaldo, si el anillo está apagado -->
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="LiveDotInline" Width="7" Height="7" Fill="{StaticResource Red}" Margin="1,0,7,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                                <TextBlock x:Name="Total" Text="0" FontFamily="{StaticResource NumFont}" FontWeight="Bold" FontSize="28"
                                           Foreground="{StaticResource GoldText}" Margin="0,-5,0,-4" RenderTransformOrigin="0,0.5">
                                    <TextBlock.RenderTransform><ScaleTransform x:Name="TotalScale"/></TextBlock.RenderTransform>
                                </TextBlock>
                            </StackPanel>
                            <TextBlock x:Name="GoalLine" Style="{StaticResource Cap}" Margin="1,1,0,0">
                                <Run x:Name="GoalNow" Text="0" Foreground="{StaticResource Muted}"/><Run x:Name="GoalSep" Text=" / "/><Run x:Name="GoalTarget" Text="0"/><Run x:Name="GoalSuffix" Text=" hoy"/>
                            </TextBlock>
                        </StackPanel>

                        <StackPanel x:Name="SessionBlock" Orientation="Horizontal">
                            <Rectangle Style="{StaticResource Divider}"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="Session" Text="0" Style="{StaticResource Stat}"/>
                                <TextBlock Text="sesión" Style="{StaticResource Cap}"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel x:Name="TreasureBlock" Orientation="Horizontal">
                            <Rectangle Style="{StaticResource Divider}"/>
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="★" FontSize="12" Foreground="{StaticResource Purple}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBlock x:Name="Treasures" Text="0" Style="{StaticResource Stat}" Foreground="{StaticResource Purple}"/>
                                </StackPanel>
                                <TextBlock Text="tesoros" Style="{StaticResource Cap}"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Brillo dorado del borde cuando se suma una partida -->
            <Border x:Name="Glow" CornerRadius="18" BorderThickness="1.5" BorderBrush="{StaticResource Gold}" Opacity="0" IsHitTestVisible="False">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="0" Color="#FCBB39" Opacity="0.85"/>
                </Border.Effect>
            </Border>

            <Rectangle x:Name="MoveFrame" RadiusX="18" RadiusY="18" Stroke="{StaticResource Gold}" StrokeThickness="2" StrokeDashArray="4 3"
                       IsHitTestVisible="False" Visibility="Collapsed"/>
        </Grid>

        <!-- ============ Momento: al terminar la partida ============ -->
        <Grid x:Name="Summary" Grid.Row="1" Margin="0,7,0,0" HorizontalAlignment="Stretch" MinWidth="250" Opacity="0" Visibility="Collapsed">
            <Grid.RenderTransform><TranslateTransform x:Name="SummaryShift"/></Grid.RenderTransform>
            <Border x:Name="SummaryCard" CornerRadius="18" BorderThickness="1">
                <Border.BorderBrush><SolidColorBrush x:Name="SummaryBorder" Color="#3DFCBB39"/></Border.BorderBrush>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#F72A1C07" Offset="0"/>
                        <GradientStop Color="#F5161D2B" Offset="0.55"/>
                        <GradientStop Color="#F20B1019" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="3" Opacity="0.55" Color="Black"/>
                </Border.Effect>
                <Grid x:Name="SummaryInner" SizeChanged="SummaryInner_SizeChanged">
                    <!-- Destello que cruza la tarjeta cuando es récord -->
                    <Rectangle x:Name="Shine" Width="90" HorizontalAlignment="Left" IsHitTestVisible="False" Opacity="0">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#00FFE7A8" Offset="0"/>
                                <GradientStop Color="#4DFFE7A8" Offset="0.5"/>
                                <GradientStop Color="#00FFE7A8" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                        <Rectangle.RenderTransform>
                            <TransformGroup>
                                <SkewTransform AngleX="-20"/>
                                <TranslateTransform x:Name="ShineShift" X="-120"/>
                            </TransformGroup>
                        </Rectangle.RenderTransform>
                    </Rectangle>

                    <StackPanel Margin="18,12,18,13">
                        <Grid>
                            <TextBlock x:Name="SummaryTitle" Text="Puesto #3 · 16 min" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                            <Border x:Name="RecordBadge" HorizontalAlignment="Right" VerticalAlignment="Center" CornerRadius="7" Padding="8,2,8,3" Margin="16,0,0,0"
                                    Background="{StaticResource Gold}" RenderTransformOrigin="0.5,0.5" Visibility="Collapsed">
                                <Border.RenderTransform><ScaleTransform x:Name="BadgeScale"/></Border.RenderTransform>
                                <TextBlock Text="NUEVO RÉCORD" FontSize="10" FontWeight="Bold" Foreground="{StaticResource GoldInk}"/>
                            </Border>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock x:Name="SummaryChests" Text="+0" FontFamily="{StaticResource NumFont}" FontWeight="Bold" FontSize="40"
                                       Foreground="{StaticResource GoldText}" Margin="-1,-4,0,-6"/>
                            <TextBlock x:Name="SummaryChestsLabel" Text="cofres" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource GoldLight}"
                                       VerticalAlignment="Bottom" Margin="8,0,0,4"/>
                        </StackPanel>
                        <TextBlock x:Name="SummaryFacts" FontSize="11.5" Foreground="{StaticResource Dim}" Margin="0,6,0,0" TextWrapping="NoWrap"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Border x:Name="SummaryGlow" CornerRadius="18" BorderThickness="1.5" BorderBrush="{StaticResource Gold}" Opacity="0" IsHitTestVisible="False">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="26" ShadowDepth="0" Color="#FCBB39" Opacity="0.9"/>
                </Border.Effect>
            </Border>
        </Grid>

        <Border x:Name="MoveHint" Grid.Row="2" Margin="0,8,0,0" CornerRadius="9" Background="#E6FCBB39" Padding="10,5"
                HorizontalAlignment="Left" Visibility="Collapsed">
            <TextBlock Foreground="{StaticResource GoldInk}" FontSize="11.5" FontWeight="SemiBold"
                       Text="Arrastrá para mover · doble clic o Ctrl+Shift+L para fijar"/>
        </Border>
    </Grid>
</Window>

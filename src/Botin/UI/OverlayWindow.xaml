<Window x:Class="Botin.UI.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Botín overlay" AllowsTransparency="True" WindowStyle="None" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize" SizeToContent="WidthAndHeight"
        FontFamily="{StaticResource UiFont}" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <Style x:Key="Lbl" TargetType="TextBlock">
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#8F98AB"/>
        </Style>
        <Style x:Key="Val" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource NumFont}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="19"/>
            <Setter Property="Foreground" Value="#F2F4F8"/>
            <Setter Property="Margin" Value="0,0,0,-3"/>
        </Style>
    </Window.Resources>

    <Grid x:Name="Root" Margin="8">
        <Grid.LayoutTransform>
            <ScaleTransform x:Name="RootScale" ScaleX="1" ScaleY="1"/>
        </Grid.LayoutTransform>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ============ Barra principal ============ -->
        <Grid>
            <Border x:Name="Card" CornerRadius="11" BorderThickness="1">
                <Border.BorderBrush><SolidColorBrush Color="#2EFFFFFF"/></Border.BorderBrush>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#FA171C29" Offset="0"/>
                        <GradientStop Color="#F70C0F16" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border.Effect>
                    <DropShadowEffect x:Name="CardShadow" BlurRadius="12" ShadowDepth="1" Opacity="0.6" Color="Black"/>
                </Border.Effect>
                <Grid>
                    <!-- Acento dorado a la izquierda -->
                    <Border Width="3" HorizontalAlignment="Left" VerticalAlignment="Stretch" Margin="6,9,0,9" CornerRadius="2">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#FFE29A" Offset="0"/>
                                <GradientStop Color="#E0901C" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <StackPanel x:Name="Content" Orientation="Horizontal" Margin="14,6,14,7">
                        <!-- Total -->
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="COFRES" Style="{StaticResource Lbl}" Foreground="#D9A845"/>
                            <Grid>
                                <TextBlock x:Name="Total" Text="0" FontFamily="{StaticResource NumFont}" FontWeight="Bold" FontSize="29"
                                           Foreground="{StaticResource GoldText}" Margin="0,-3,0,-4" RenderTransformOrigin="0,0.5">
                                    <TextBlock.RenderTransform><ScaleTransform x:Name="TotalScale"/></TextBlock.RenderTransform>
                                </TextBlock>
                            </Grid>
                        </StackPanel>

                        <StackPanel x:Name="SessionBlock" Orientation="Horizontal">
                            <Rectangle Width="1" Margin="12,5,11,5" Fill="#1FFFFFFF"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="SESIÓN" Style="{StaticResource Lbl}"/>
                                <TextBlock x:Name="Session" Text="0" Style="{StaticResource Val}"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel x:Name="LastBlock" Orientation="Horizontal">
                            <Rectangle Width="1" Margin="11,5,11,5" Fill="#1FFFFFFF"/>
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Grid x:Name="LiveDot" Width="7" Height="7" Margin="0,0,5,0" VerticalAlignment="Center" Visibility="Collapsed">
                                        <Ellipse x:Name="LiveHalo" Fill="#FF5C6C" RenderTransformOrigin="0.5,0.5">
                                            <Ellipse.RenderTransform><ScaleTransform x:Name="LiveHaloScale"/></Ellipse.RenderTransform>
                                        </Ellipse>
                                        <Ellipse Fill="#FF5C6C"/>
                                    </Grid>
                                    <TextBlock x:Name="LastLabel" Text="ÚLTIMA" Style="{StaticResource Lbl}"/>
                                </StackPanel>
                                <TextBlock x:Name="Last" Text="–" Style="{StaticResource Val}"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel x:Name="TreasureBlock" Orientation="Horizontal">
                            <Rectangle Width="1" Margin="11,5,11,5" Fill="#1FFFFFFF"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="TESOROS" Style="{StaticResource Lbl}"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="★" FontSize="12.5" Foreground="#C6A8FF" VerticalAlignment="Center" Margin="0,1,3,0"/>
                                    <TextBlock x:Name="Treasures" Text="0" Style="{StaticResource Val}" Foreground="#C6A8FF"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Brillo dorado del borde cuando se suma una partida -->
            <Border x:Name="Glow" CornerRadius="11" BorderThickness="2" BorderBrush="#F7B93E" Opacity="0" IsHitTestVisible="False">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="22" ShadowDepth="0" Color="#F7B93E" Opacity="0.9"/>
                </Border.Effect>
            </Border>

            <Rectangle x:Name="MoveFrame" RadiusX="11" RadiusY="11" Stroke="#F7B93E" StrokeThickness="2" StrokeDashArray="4 3"
                       IsHitTestVisible="False" Visibility="Collapsed"/>
        </Grid>

        <!-- ============ Resumen al terminar la partida ============ -->
        <Border x:Name="Summary" Grid.Row="1" Margin="0,6,0,0" CornerRadius="10" BorderThickness="1" BorderBrush="#4DF7B93E"
                HorizontalAlignment="Left" Padding="12,7,14,8" Opacity="0" Visibility="Collapsed">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#FA2A2010" Offset="0"/>
                    <GradientStop Color="#F7121722" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.55" Color="Black"/>
            </Border.Effect>
            <Border.RenderTransform><TranslateTransform x:Name="SummaryShift"/></Border.RenderTransform>
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="SummaryTitle" Text="PARTIDA TERMINADA" Style="{StaticResource Lbl}" Foreground="#D9A845"/>
                    <TextBlock x:Name="SummaryPlace" Text="" Style="{StaticResource Lbl}" Margin="8,0,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                    <TextBlock x:Name="SummaryChests" Text="+0" FontFamily="{StaticResource NumFont}" FontWeight="Bold" FontSize="22"
                               Foreground="{StaticResource GoldText}" VerticalAlignment="Bottom"/>
                    <TextBlock x:Name="SummaryChestsLabel" Text="cofres" FontSize="11.5" FontWeight="SemiBold" Foreground="#E7D3A6"
                               VerticalAlignment="Bottom" Margin="6,0,0,4"/>
                    <StackPanel x:Name="SummaryTreasureBlock" Orientation="Horizontal" VerticalAlignment="Bottom">
                        <Ellipse Width="4" Height="4" Fill="#5A6377" Margin="12,0,12,10" VerticalAlignment="Bottom"/>
                        <TextBlock x:Name="SummaryTreasures" Text="★ +1" FontFamily="{StaticResource NumFont}" FontWeight="Bold" FontSize="19"
                                   Foreground="#C6A8FF" VerticalAlignment="Bottom" Margin="0,0,0,1"/>
                        <TextBlock x:Name="SummaryTreasuresLabel" Text="tesoro" FontSize="11.5" FontWeight="SemiBold" Foreground="#C6A8FF"
                                   VerticalAlignment="Bottom" Margin="6,0,0,4"/>
                    </StackPanel>
                    <StackPanel x:Name="SummaryRecordBlock" Orientation="Horizontal" VerticalAlignment="Bottom">
                        <Ellipse Width="4" Height="4" Fill="#5A6377" Margin="12,0,12,10" VerticalAlignment="Bottom"/>
                        <Border CornerRadius="6" Background="#F7B93E" Padding="7,2" Margin="0,0,0,4" VerticalAlignment="Bottom">
                            <TextBlock Text="¡RÉCORD!" FontSize="10.5" FontWeight="Bold" Foreground="#1A1205"/>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border x:Name="MoveHint" Grid.Row="2" Margin="0,8,0,0" CornerRadius="8" Background="#E6F7B93E" Padding="10,5"
                HorizontalAlignment="Left" Visibility="Collapsed">
            <TextBlock Foreground="#1A1205" FontSize="11.5" FontWeight="SemiBold"
                       Text="Arrastrá para mover · doble clic o Ctrl+Shift+L para fijar"/>
        </Border>
    </Grid>
</Window>
